# Copy this file to .env and fill in your values

# Private key for deploying contracts (without 0x prefix)
# You can get this from your wallet (MetaMask, etc.)
PRIVATE_KEY=your_private_key_here

# SonicScan API key for contract verification
# Get this from https://sonicscan.org/apis
SONICSCAN_API_KEY=your_sonicscan_api_key_here

# Alternative RPC endpoints (optional)
# SONIC_RPC_URL=https://rpc.soniclabs.com
# SONIC_TESTNET_RPC_URL=https://api.testnet.sonic.game 