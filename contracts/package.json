{
  "name": "sonicity-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Sonicity game",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "node": "npx hardhat node",
    "anvil:sonic": "./scripts/start-anvil-sonic.sh",
    "anvil:reset": "rm -rf .anvil-state && ./scripts/start-anvil-sonic.sh",
    "anvil:testnet": "anvil --fork-url https://api.testnet.sonic.game --chain-id 64165 --port 8545 --host 0.0.0.0",
    "time": "npx hardhat run scripts/anvil-time-utils.js --network localhost",
    "estimate": "npx hardhat run scripts/estimate-deployment-cost.js --network localhost",
    "estimate:testnet": "npx hardhat run scripts/estimate-deployment-cost.js --network testnet",
    "estimate:mainnet": "npx hardhat run scripts/estimate-deployment-cost.js --network mainnet",
    "deploy": "npx hardhat run scripts/deploy.js --network localhost && npx hardhat run scripts/approveCollection.js --network localhost && ../scripts/update-addresses.sh",
    "deploy:grid": "npx hardhat run scripts/deploy-grid.js --network localhost && ../scripts/update-addresses.sh",
    "deploy:testnet": "npx hardhat run scripts/deploy.js --network testnet && npx hardhat run scripts/approveCollection.js --network testnet && ../scripts/update-addresses.sh",
    "deploy:grid:testnet": "npx hardhat run scripts/deploy-grid.js --network testnet && ../scripts/update-addresses.sh",
    "deploy:mainnet": "npx hardhat run scripts/deploy.js --network mainnet && npx hardhat run scripts/approveCollection.js --network mainnet && ../scripts/update-addresses.sh",
    "deploy:grid:mainnet": "npx hardhat run scripts/deploy-grid.js --network mainnet && ../scripts/update-addresses.sh",
    "upgrade": "npx hardhat run scripts/upgrade.js --network localhost && ../scripts/update-addresses.sh",
    "upgrade:testnet": "npx hardhat run scripts/upgrade.js --network testnet && ../scripts/update-addresses.sh",
    "upgrade:mainnet": "npx hardhat run scripts/upgrade.js --network mainnet && ../scripts/update-addresses.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/contracts-upgradeable": "^5.3.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.1"
  }
}
